{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/implement-issue/project-blueprint.schema.json",
  "title": "Implement Issue Project Blueprint",
  "type": "object",
  "required": [
    "schema_version",
    "blueprint_version",
    "project",
    "decisions",
    "unresolved",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "blueprint_version": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "type": "object",
      "required": [
        "goal",
        "type"
      ],
      "properties": {
        "goal": {
          "$ref": "#/$defs/decision"
        },
        "type": {
          "$ref": "#/$defs/decision"
        }
      },
      "additionalProperties": true
    },
    "decisions": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "runtimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "dependency_management": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "persistence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "migrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "testing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "quality": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "ci_cd": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "deployment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "architecture": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "external_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "security": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "performance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "reliability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "accessibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "compatibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "observability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        }
      },
      "additionalProperties": true
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "approved_by_human"
      ],
      "properties": {
        "approved_by_human": {
          "type": "boolean"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": [
        "state",
        "value",
        "source",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "decided",
            "undecided",
            "not_applicable"
          ]
        },
        "value": {},
        "source": {
          "enum": [
            "human",
            "documentation",
            null
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
