{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/implement-issue/project-profile.schema.json",
  "title": "Implement Issue Project Profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_version",
    "project",
    "observed",
    "commands",
    "unknowns",
    "conflicts",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "type": "object",
      "required": [
        "repository_shape",
        "components"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository_shape": {
          "$ref": "#/$defs/fact"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "observed": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "runtimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "dependency_managers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "persistence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "migration_systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "quality_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "ci_cd": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "architecture": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "testing_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "security_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "performance_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "observability_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "object",
      "properties": {
        "dev": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "build": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "test": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "lint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "format_check": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "typecheck": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "migrate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "smoke": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "security": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "benchmark": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "performance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "load": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "stress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "accessibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "compatibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "recovery": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      },
      "additionalProperties": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "approved_by_human"
      ],
      "properties": {
        "approved_by_human": {
          "type": "boolean"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "enum": [
            "manifest",
            "lockfile",
            "config",
            "source",
            "script",
            "ci",
            "migration",
            "runtime",
            "documentation",
            "human"
          ]
        },
        "path": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "status",
        "value",
        "confidence",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "unknown",
            "not_detected",
            "absent",
            "not_applicable",
            "conflict"
          ]
        },
        "value": {},
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "additionalProperties": true
    },
    "command": {
      "type": "object",
      "required": [
        "command",
        "confidence",
        "evidence"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "Semantic validation/command kind such as unit, integration, security, benchmark, load, accessibility, or a project-specific category."
        },
        "destructive": {
          "type": "boolean",
          "default": false
        },
        "production_safe": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
